IO_LOC "clk_27m" E2;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// 行 X0~X7 (PMOD0)
IO_LOC "row_o[0]" J5;  IO_LOC "row_o[1]" H5;
IO_LOC "row_o[2]" H7;  IO_LOC "row_o[3]" H8;
IO_LOC "row_o[4]" G8;  IO_LOC "row_o[5]" G7;
IO_LOC "row_o[6]" G5;  IO_LOC "row_o[7]" F5;
IO_PORT "row_o[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "row_o[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "row_o[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "row_o[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "row_o[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "row_o[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "row_o[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "row_o[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// 列 Y0~Y7 (PMOD1, 填脚名) —— 必须 PULL_MODE=UP!
IO_LOC "col_i[0]" <PMOD1脚0>;  IO_LOC "col_i[1]" <PMOD1脚1>;
IO_LOC "col_i[2]" <PMOD1脚2>;  IO_LOC "col_i[3]" <PMOD1脚3>;
IO_LOC "col_i[4]" <PMOD1脚4>;  IO_LOC "col_i[5]" <PMOD1脚5>;
IO_LOC "col_i[6]" <PMOD1脚6>;  IO_LOC "col_i[7]" <PMOD1脚7>;
IO_PORT "col_i[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "col_i[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "col_i[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "col_i[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "col_i[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "col_i[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "col_i[6]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_PORT "col_i[7]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// I2S (你之前已验证)
IO_LOC "bclk" K4;  IO_LOC "lrc" L1;  IO_LOC "din" K2;
